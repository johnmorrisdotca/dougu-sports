{
  "name": "@johnmorrisdotca/dougu-sports",
  "version": "0.30.0",
  "description": "Dougu Sports 道具 — Sports emblems as SVG for JavaScript: trophies, medals, crests, sport icons, and the ball and gear of every sport, in metal, line or flat colour, with optional 3D turning and a tag for any page. Light and dark, accessible, tree-shakeable. Zero dependencies.",
  "keywords": [
    "sports",
    "emblem",
    "trophy",
    "medal",
    "crest",
    "award",
    "ball",
    "sports-equipment",
    "sports-icons",
    "pennant",
    "icons",
    "svg",
    "3d",
    "turntable",
    "tree-shakeable",
    "accessible",
    "dark-mode",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "node",
    "itsutsu"
  ],
  "homepage": "https://johnmorrisdotca.github.io/dougu-sports/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/dougu-sports.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/dougu-sports/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./emblems": {
      "types": "./dist/emblems-entry.d.ts",
      "import": "./dist/emblems-entry.js",
      "default": "./dist/emblems-entry.js"
    },
    "./brands": {
      "types": "./dist/brands-entry.d.ts",
      "import": "./dist/brands-entry.js",
      "default": "./dist/brands-entry.js"
    },
    "./turn": {
      "types": "./dist/turn-entry.d.ts",
      "import": "./dist/turn-entry.js",
      "default": "./dist/turn-entry.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./award/*": {
      "types": "./dist/emblems/award/*.d.ts",
      "import": "./dist/emblems/award/*.js",
      "default": "./dist/emblems/award/*.js"
    },
    "./trophy/*": {
      "types": "./dist/emblems/trophy/*.d.ts",
      "import": "./dist/emblems/trophy/*.js",
      "default": "./dist/emblems/trophy/*.js"
    },
    "./medal/*": {
      "types": "./dist/emblems/medal/*.d.ts",
      "import": "./dist/emblems/medal/*.js",
      "default": "./dist/emblems/medal/*.js"
    },
    "./crest/*": {
      "types": "./dist/emblems/crest/*.d.ts",
      "import": "./dist/emblems/crest/*.js",
      "default": "./dist/emblems/crest/*.js"
    },
    "./sport/*": {
      "types": "./dist/emblems/sport/*.d.ts",
      "import": "./dist/emblems/sport/*.js",
      "default": "./dist/emblems/sport/*.js"
    },
    "./ball/*": {
      "types": "./dist/emblems/ball/*.d.ts",
      "import": "./dist/emblems/ball/*.js",
      "default": "./dist/emblems/ball/*.js"
    },
    "./gear/*": {
      "types": "./dist/emblems/gear/*.d.ts",
      "import": "./dist/emblems/gear/*.js",
      "default": "./dist/emblems/gear/*.js"
    },
    "./pennant/*": {
      "types": "./dist/emblems/pennant/*.d.ts",
      "import": "./dist/emblems/pennant/*.js",
      "default": "./dist/emblems/pennant/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.demo.json",
    "test": "node --test test/*.test.ts",
    "test:package": "pnpm build && node scripts/check-package.ts",
    "test:readme": "pnpm build && node scripts/make-gallery.ts --check && node scripts/check-readme-examples.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-package.ts",
    "prepublishOnly": "pnpm check",
    "family:readme": "node scripts/family-readme.mjs",
    "dev": "pnpm build && node scripts/dev.ts",
    "gallery": "pnpm build && node scripts/make-gallery.ts",
    "flags": "node scripts/make-flags.mjs",
    "site": "pnpm build && node scripts/site.ts",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "screenshots": "pnpm site && node scripts/screenshots.ts",
    "animations": "pnpm build && node scripts/animations.ts",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size",
    "check:standard": "node scripts/check-standard.mjs",
    "test:usage": "pnpm site && node scripts/check-usage.ts"
  },
  "devDependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@eslint/js": "^9.0.0",
    "@johnmorrisdotca/hata": "1.5.0",
    "@johnmorrisdotca/kazoku-ui": "^0.11.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "marked": "^18.1.3",
    "pagefind": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
